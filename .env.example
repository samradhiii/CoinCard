# ---- Postgres (docker compose) ----
POSTGRES_USER=coincard
POSTGRES_PASSWORD=coincard
POSTGRES_DB=coincard
# Host port for Postgres. 5433 by default so it never fights a local Postgres on 5432.
POSTGRES_PORT=5433

# ---- Backend ----
API_PORT=8000
# Used when you run the API on the host (not in compose). Note the host port above.
DATABASE_URL=postgresql://coincard:coincard@localhost:5433/coincard
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
